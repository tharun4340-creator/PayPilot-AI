# Local development defaults. Copy this file to .env and keep real keys out of Git.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///./paypilot.db
AUTO_CREATE_TABLES=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PayPal Sandbox. Leaving these blank keeps the app in labelled demo mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_DEFAULT_CURRENCY=USD

# Optional free-tier Gemini API key for real tool-calling AI.
# Create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
